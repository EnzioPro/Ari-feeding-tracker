rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone holding a family link can read and write that family's log.
    match /families/{familyId} {
      allow read, write: if familyId.size() >= 6;
      match /feeds/{feedId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.time is number
                              && request.resource.data.oz is number
                              && request.resource.data.oz >= 0 && request.resource.data.oz <= 16;
      }
      match /sleeps/{sleepId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.start is number
                              && (request.resource.data.end == null
                                  || (request.resource.data.end is number && request.resource.data.end > request.resource.data.start));
      }
      match /diapers/{diaperId} {
        allow read, delete: if true;
        allow create, update: if request.resource.data.time is number
                              && request.resource.data.kind in ['pee', 'poo', 'both', 'dry']
                              && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      }
      // One copy of the log from the last "Clear all data", kept so anyone can undo it for a day.
      match /undo/{docId} {
        allow read, delete: if docId == 'latest';
        allow create, update: if docId == 'latest' && request.resource.data.clearedAt is number
                              && request.resource.data.feeds is list && request.resource.data.sleeps is list
                              && request.resource.data.diapers is list;
      }
    }
  }
}
